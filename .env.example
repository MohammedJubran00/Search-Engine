# External APIs
GEMINI_API_KEY=replace-with-your-gemini-api-key
TAVILY_API_KEY=replace-with-your-tavily-api-key

# PostgreSQL (used by SQLAlchemy and Alembic)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=search_engine
DB_USER=search_engine
DB_PASSWORD=replace-with-a-strong-password

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# RAG preparation. Relative storage paths resolve from the process working directory.
RAG_STORAGE_DIR=data/uploads
RAG_MAX_UPLOAD_BYTES=10485760
RAG_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_EMBEDDING_MODEL=models/gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_DOCUMENT_TASK_TYPE=RETRIEVAL_DOCUMENT
RAG_EMBEDDING_QUERY_TASK_TYPE=RETRIEVAL_QUERY
RAG_EMBEDDING_NORMALIZE=true
RAG_EMBEDDING_BATCH_SIZE=100
RAG_EMBEDDING_MAX_CONCURRENCY=2
RAG_EMBEDDING_MAX_RETRIES=3
RAG_EMBEDDING_RETRY_BASE_SECONDS=1.0
